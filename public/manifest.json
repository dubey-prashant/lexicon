{
  "name": "LEXICON",
  "description": "Fast English dictionary with pronunciations, examples, search history & word of the day.",
  "version": "2.2.0",
  "author": "Prashant Dubey",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "LEXICON - Dictionary Lookup"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}